APP_NAME=CyberSim AI
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-at-least-16-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./cybersim.db
POSTGRES_PASSWORD=

# Configure a valid key to use OpenAI. For offline demonstrations set LLM_PROVIDER=mock.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=1
OPENAI_MAX_TOKENS=3000

# Set ADMIN_PASSWORD before using the optional bootstrap administrator.
ADMIN_EMAIL=admin@cybersim.local
ADMIN_PASSWORD=
STREAMLIT_API_URL=http://localhost:8000
